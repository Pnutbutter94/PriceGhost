FROM ghcr.io/clucraft/priceghost-frontend:latest

# #B346 low: no CSP anywhere, compensating control for JWT-in-localStorage.
# frontend/nginx.conf in this repo mirrors the upstream image's default.conf
# byte-for-byte except for the added header below (verified against the
# running image before this patch) — this repo's own Dockerfile was never
# wired into docker-compose.yml (service pulled the upstream image directly),
# so patch the upstream image's conf directly instead of switching to a full
# local source build.
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
